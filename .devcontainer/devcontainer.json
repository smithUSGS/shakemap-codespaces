{
  "name": "ShakeMap Workshop",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "hostRequirements": { "cpus": 4 },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.fontSize": 14,
        "workbench.startupEditor": "none",
        "explorer.confirmDelete": false,
        "files.simpleDialog.enable": true,
        "notebook.autoSave": "off",
        "security.workspace.trust.enabled": false,
        "window.restoreWindows": "none",
        "python.analysis.diagnosticMode": "openFilesOnly",
        "python.analysis.indexing": false,
        "python.analysis.exclude": [
          "/home/vscode/shakemap/**",
          "/home/vscode/groundfailure/**",
          "/opt/conda/**"
        ],
        "files.watcherExclude": {
          "/home/vscode/shakemap/**": true,
          "/home/vscode/groundfailure/**": true,
          "/opt/conda/**": true
        }
      }
    }
  },
  "workspaceMountConsistency": "cached",
  "remoteUser": "vscode",
  "workspaceFile": "/workspaces/shakemap-gf-workshop/workshop.code-workspace",
  "postCreateCommand": "bash -lc 'conda activate shakemap && shake -v 2>&1 | head -1'",
  "postAttachCommand": "bash -lc 'cp /workspaces/shakemap-gf-workshop/data/plot_gf_interactive.py ~/plot_gf_interactive.py; echo \"Workshop environment ready.\"'"
}
