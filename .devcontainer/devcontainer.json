{
  "name": "ShakeMap Workshop (v4.4.9)",

  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": { "SHAKEMAP_VERSION": "v4.4.9" }
  },

  "hostRequirements": { "cpus": 2 },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.fontSize": 14,
        "workbench.startupEditor": "none",
        "explorer.confirmDelete": false,
        "files.simpleDialog.enable": true
      }
    }
  },

  "workspaceMountConsistency": "cached",

  "remoteUser": "vscode",

  "postCreateCommand": "bash -lc 'conda activate shakemap && shake -v 2>&1 | head -1'",
  "postAttachCommand": "bash -lc 'echo \"Workshop environment ready. See README.md to get started.\"'"
}
