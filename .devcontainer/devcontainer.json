{
  "name": "ShakeMap Workshop",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "hostRequirements": { "cpus": 2 },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.fontSize": 14,
        "workbench.startupEditor": "none",
        "explorer.confirmDelete": false,
        "files.simpleDialog.enable": true
      }
    }
  },
  "workspaceMountConsistency": "cached",
  "remoteUser": "vscode",
  "workspaceFile": "/workspaces/shakemap-codespaces/workshop.code-workspace",
  "postCreateCommand": "bash -lc 'conda activate shakemap && shake -v 2>&1 | head -1'",
  "postAttachCommand": "bash -lc 'echo \"Workshop environment ready. See README.md to get started.\"'"
}
